# LLM API-Keys
OPENROUTER_API_KEY=your_openrouter_key
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key

# Container-Sicherheit: Muss mit deinem WSL-User übereinstimmen (id -u / id -g)
USER_ID=1000
GROUP_ID=1000

# Pfad zum Repo in WSL2 (UNC-Pfad für Windows Docker Desktop)
REPO_PATH=\\wsl.localhost\Ubuntu\home\unixusername\nodges

# Pfad zum benutzerdefinierten WSL-Verzeichnis (für AGENTS.md und eigene Dateien)
CUSTOM_PATH=/home/unixusername/.pi

# SSH-Agent-Socket vom WSL-Host für Git-Operations (sicherer als Token im Container)
# Prüfe mit: echo $SSH_AUTH_SOCK
SSH_AUTH_SOCK=/run/user/1000/keyring/ssh

# Fallback: GitHub PAT (nur wenn kein SSH-Agent verfügbar).
# WARNUNG: Pi kann diesen Token lesen und damit GitHub-API aufrufen.
GITHUB_TOKEN=
