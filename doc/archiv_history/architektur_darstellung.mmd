---
title: "Nodges Darstellungsarchitektur"
---
graph TB
    subgraph Datenquelle["Datenquelle"]
        JSON["JSON-Datei"]
        LLM["LLM-Service"]
    end

    subgraph Parser["DataParser"]
        Schema["Zod-Schema-Validierung"]
        DM["DataModel Extraktion"]
        VM["VisualMappings Extraktion"]
    end

    subgraph StateManager["StateManager -- Single Source of Truth"]
        Entities["entities[]"]
        Relationships["relationships[]"]
        VisualState["Visual States"]
        LayerState["Layer States"]
    end

    subgraph MappingEngine["VisualMappingEngine"]
        Linear["linear"]
        Expo["exponential"]
        Log["logarithmic"]
        Heat["heatmap"]
        Bipolar["bipolar"]
        Pulse["pulse"]
        Cat["categorical"]
        Const["constant"]
    end

    subgraph NodeVisuals["Node Darstellung"]
        NPos["Position x,y,z"]
        NSize["Groesse"]
        NColor["Farbe"]
        NGeom["Geometrie"]
        NGlow["Glow"]
        NOpac["Opacity via Layer"]
        NLabel["Label"]
        NOutline["Outline"]
    end

    subgraph EdgeVisuals["Edge Darstellung"]
        EThick["Dicke"]
        EColor["Farbe"]
        ECurve["Kruemmung"]
        EOpac["Opacity"]
        EGlow["Glow"]
        EPulse["Pulse-Animation"]
        EWave["Wave-Animation"]
        EFlow["Flow-Animation"]
        ESegs["Segments-Animation"]
        ELabel["Label"]
        EOutline["Outline"]
    end

    subgraph Interaktion["Interaktion"]
        Hover["Hover Highlight"]
        Select["Selection Highlight"]
        Search["Suche"]
        Path["Pfadfindung"]
        Nbr["Nachbarschaft"]
    end

    subgraph Rendering["Three.js Rendering"]
        IM["InstancedMesh -- Nodes"]
        TG["TubeGeometry -- Edges"]
        CSS2D["CSS2DRenderer -- Labels"]
        Scene["Scene + Camera + Lights"]
    end

    JSON --> Schema
    LLM --> Schema
    Schema --> DM
    Schema --> VM
    DM --> StateManager
    VM --> MappingEngine

    StateManager --> MappingEngine
    MappingEngine --> NodeVisuals
    MappingEngine --> EdgeVisuals

    StateManager --> LayerState
    LayerState --> NOpac
    LayerState --> EOpac

    NodeVisuals --> IM
    EdgeVisuals --> TG
    NLabel --> CSS2D
    ELabel --> CSS2D

    IM --> Scene
    TG --> Scene
    CSS2D --> Scene

    Interaktion --> NodeVisuals
    Interaktion --> EdgeVisuals
