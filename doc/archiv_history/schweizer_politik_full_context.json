{
  "system": "Schweizer_Politik_Full_Context",
  "metadata": {
    "schemaVersion": "4.0",
    "description": "Detailliertes Modell der Schweizer Politik basierend auf dem gesamten Nodges-Projektwissen (inkl. Deltas, unendlichem ValidTo und Map-Integration).",
    "author": "Antigravity",
    "map": {
      "image": "Switzerland.jpg",
      "referenceWidth": 1000,
      "referenceHeight": 650
    }
  },
  "dataModel": {
    "entities": {
      "institution": {
        "properties": {
          "power_level": { "type": "continuous", "range": [0, 100] },
          "branch": { "type": "categorical", "values": ["Legislative", "Exekutive", "Judikative"] }
        }
      },
      "partei": {
        "properties": {
          "waehleranteil": { "type": "continuous", "range": [0, 50] },
          "spektrum": { "type": "categorical", "values": ["Links", "Mitte", "Rechts"] }
        }
      }
    },
    "relationships": {
      "waehlt": { "properties": {} },
      "einfluss": { "properties": {} }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "institution": {
        "color": { "source": "branch", "function": "categorical" },
        "size": { "source": "power_level", "function": "linear", "range": [1.0, 2.5] }
      },
      "partei": {
        "color": { "source": "spektrum", "function": "categorical" },
        "size": { "source": "waehleranteil", "function": "linear", "range": [0.5, 2.0] }
      },
      "waehlt": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#aaaaaa" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.1, 0.1] }
      },
      "einfluss": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#ffaa00" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.05, 0.05] }
      }
    }
  },
