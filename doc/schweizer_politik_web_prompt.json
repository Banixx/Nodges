  "dataModel": {
    "entities": {
      "Partei": {
        "properties": {
          "ausrichtung": { "type": "categorical", "values": ["Links", "Mitte", "Rechts"] },
          "waehleranteil": { "type": "continuous", "range": [0, 40] }
        }
      },
      "Institution": {
        "properties": {
          "gewalt": { "type": "categorical", "values": ["Exekutive", "Legislative", "Judikative"] },
          "bedeutung": { "type": "continuous", "range": [1, 10] }
        }
      }
    },
    "relationships": {
      "Koalition": { "properties": {} },
      "Kontrolle": { "properties": {} }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "Partei": {
        "color": { "source": "ausrichtung", "function": "categorical" },
        "size": { "source": "waehleranteil", "function": "linear", "range": [0.5, 1.5] }
      },
      "Institution": {
        "color": { "source": "gewalt", "function": "categorical" },
        "size": { "source": "bedeutung", "function": "linear", "range": [0.5, 1.5] }
      },
      "Koalition": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#aaaaaa" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.08, 0.08] }
      },
      "Kontrolle": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#ff0000" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.08, 0.08] }
      }
    }
  },
