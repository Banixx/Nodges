graph TD
    subgraph N2["Aktuell: O(N²) Brute-Force"]
        B1["500 Knoten\n= 500 x 499 = 249.500 Vergleiche\npro Frame"]
        B2["2000 Knoten\n= 2000 x 1999 = 3.998.000 Vergleiche\npro Frame → Engpass"]
        B3["Jeder Knoten vergleicht\nseine Position mit\nJEDEM anderen Knoten\num Abstossungskraft\nzu berechnen"]
        B1 --> B2
        B3 -.-> B2
    end

    subgraph BH["d3-force-3d: O(N log N) Barnes-Hut"]
        O1["Octree wird aufgebaut\n3D-Raum wird rekursiv\nin 8 Oktanten unterteilt"]
        O2["Weit entfernte Knoten-Gruppen\nwerden als EINE Masse\nbehandelt\nnicht einzeln verglichen"]
        O3["500 Knoten\n≈ 500 x 9 = 4.500 Vergleiche"]
        O4["2000 Knoten\n≈ 2000 x 11 = 22.000 Vergleiche\nstatt 4 Millionen"]
        O5["50.000 Knoten\nfluessig simulierbar\nohne Game-Engine"]
        O1 --> O2 --> O3 --> O4 --> O5
    end

    subgraph VERGLEICH["Vergleich bei N = 10.000"]
        V1["O(N²): 100.000.000 Ops\n→ Layout-Thread friert ein"]
        V2["O(N log N): ~140.000 Ops\n→ fluessig im WebWorker"]
        V1 -.->|"714x langsamer"| V2
    end

    N2 --> VERGLEICH
    BH --> VERGLEICH

    style N2 fill:#3a1a1a,stroke:#e53935,color:#ffcdd2
    style BH fill:#1a3a1a,stroke:#43a047,color:#c8e6c9
