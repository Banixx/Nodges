    subgraph ARCH["Build 5: LLM als Ontologie-Architekt (2-Phasen)"]
        direction TB
        PH1["Phase 1: Schema-Erfindung\n'Analysiere das Thema und entwirf\nein vollstaendiges Metadaten-Schema'"]
        PH1 --> SCHEMA["LLM erfindet:\nnodeTypes: [person, company]\nedgeTypes: [works_for, owns]\nproperties: [influence, founded]"]
