erDiagram
    GraphData {
        object dataModel
        object visualMappings
        array entities
        array relationships
    }

    DataModel {
        array nodeTypes
        array edgeTypes
    }

    NodeType {
        string id
        string label
        array properties
    }

    EdgeType {
        string id
        string label
        array properties
    }

    VisualMappings {
        object nodes
        object edges
    }

    VisualChannel {
        string property
        string scale
    }

    Entity {
        string id
        string type
        string label
        object properties
        object temporal
    }

    Relationship {
        string id
        string source
        string target
        string type
        object properties
        object temporal
    }

    Temporal {
        number validFrom
        number validTo
        array history
    }

    GraphData ||--|| DataModel : "enthaelt"
    GraphData ||--|| VisualMappings : "enthaelt"
