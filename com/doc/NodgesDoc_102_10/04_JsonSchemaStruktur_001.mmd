    GraphData ||--o{ Relationship : "relationships"
    DataModel ||--o{ NodeType : "nodeTypes"
    DataModel ||--o{ EdgeType : "edgeTypes"
    VisualMappings ||--o{ VisualChannel : "nodes.*"
    VisualMappings ||--o{ VisualChannel : "edges.*"
    Entity ||--o| Temporal : "optional temporal"
    Relationship ||--|| Entity : "source-ID"
    Relationship ||--|| Entity : "target-ID"
