lightrag-backend/rag_storage/

# Build outputs
dist/
build/

# Environment files
.env
.env.local

# AI and Tooling
.agent/
# .agents/skills/ wird VERSIONIERT: die Workspace-Skills von conT liegen dort und
mussen fuer beide Harnesses im Git gesichert sein. Alles andere unter .agents/ bleibt draussen.
.agents/*
!.agents/skills/
.clinerules
.antigravityignore

# Documentation
# doc/ wird NICHT mehr ignoriert (Freigabe Benutzer 2026-09-24).
# Arbeitsdokumente muessen zwischen beiden Harnesses (piCon + Antigravity)
# ueber GitHub verfuegbar sein. Siehe setup.md Abschnitt 4.

download/

