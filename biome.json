{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["src/**", "e2e/**", "*.ts", "*.json", "!!**/dist", "!!**/node_modules", "!!**/com/doc"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "noThisInStatic": "off",
                "noStaticOnlyClass": "off",
                "useArrowFunction": "off",
                "useOptionalChain": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "useIterableCallbackReturn": "off",
                "noGlobalIsNan": "off",
                "noImplicitAnyLet": "warn"
            },
            "correctness": {
                "noUnusedVariables": "off",
                "noUnsafeOptionalChaining": "warn"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useConst": "warn",
                "useImportType": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    },
    "assist": {
        "enabled": false
    }
}
