{
    "name": "nodges",
    "version": "0.106.14",
    "description": "3D Network Visualization with Three.js",
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "knip": "knip",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:backend": "cd lightrag-backend && ./venv/bin/pytest tests/",
        "export:schema": "vitest run src/tests/exportSchema.test.ts",
        "lightrag": "cd lightrag-backend && ./venv/bin/python main.py",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:fast": "tsc --noEmit && vitest run && npm run test:backend",
        "test:all": "tsc --noEmit && vitest run && playwright test"
    },
    "dependencies": {
        "@tweenjs/tween.js": "^18.6.4",
        "lil-gui": "^0.19.1",
        "pdfjs-dist": "^4.10.38",
        "three": "^0.161.0",
        "zod": "^3.22.4",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@playwright/test": "^1.63.0",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^20.11.19",
        "@types/three": "^0.161.2",
        "@vitest/coverage-v8": "^1.6.1",
        "@vitest/ui": "^1.6.1",
        "body-parser": "^2.3.0",
        "happy-dom": "^20.6.1",
        "jsdom": "^28.0.0",
        "knip": "^6.38.0",
        "rollup-plugin-visualizer": "^7.1.1",
        "typescript": "^5.3.3",
        "vite": "^5.1.4",
        "vitest": "^1.6.1"
    }
}
