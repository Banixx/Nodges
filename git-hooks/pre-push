#!/bin/sh
# pre-push — erzwingt die Regel: nach GitHub gehen AUSSCHLIESSLICH Major-Versionen (X.0.0).
# Patch- und Minor-Versionen bleiben lokal.
# Ausnahme fuer Notfaelle: NODGES_ALLOW_PUSH=1

[ "${NODGES_ALLOW_PUSH:-}" = "1" ] && exit 0

# Version aus dem Commit lesen, der gerade gepusht wird (kein node noetig, damit der
# Hook auch unter Git fuer Windows bei conT laeuft).
version="$(git show HEAD:package.json 2>/dev/null \
  | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  | head -n 1)"

if [ -z "$version" ]; then
  echo "ABBRUCH: Version aus HEAD:package.json nicht lesbar." >&2
  exit 1
fi

minor="$(printf '%s' "$version" | cut -d'.' -f2 2>/dev/null || true)"
patch="$(printf '%s' "$version" | cut -d'.' -f3 2>/dev/null || true)"
tag="$(git tag --points-at HEAD 2>/dev/null | head -n 1)"

if [ "$minor" != "0" ] || [ "$patch" != "0" ]; then
  echo "PUSH BLOCKIERT: Version $version ist keine Major-Version (X.0.0)." >&2
  echo "" >&2
  echo "  Gemaess Benutzerbeschluss duerfen Patch- und Minor-Versionen NICHT nach GitHub gepusht werden." >&2
  echo "  Zwischenstand sichern:       tools/nodges-git.sh save" >&2
  echo "  Lokalen Meilenstein setzen:  tools/nodges-git.sh release" >&2
  echo "  Major-Release vorbereiten:   tools/nodges-git.sh major   (erfordert Benutzerfreigabe)" >&2
  echo "  Notfall-Override (manuell):  NODGES_ALLOW_PUSH=1 git push origin main" >&2
  exit 1
fi

exit 0
