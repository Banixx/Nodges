#!/bin/sh
# post-commit — kurze Rueckmeldung nach jedem Commit.

version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' package.json 2>/dev/null | head -n 1)"
kurz="$(git rev-parse --short HEAD 2>/dev/null)"

if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  voraus="$(git rev-list --count origin/main..HEAD 2>/dev/null)"
else
  voraus="unbekannt"
fi

echo "Gesichert: Version ${version:-?} · Commit ${kurz:-?} · lokal $voraus Commit(s) vor GitHub"
