{
    "system": "Social Network Cluster",
    "metadata": {
        "created": "2026-01-13T10:10:00Z",
        "description": "Visualisierung eines sozialen Netzwerks mit Influencern und Gruppen"
    },
    "dataModel": {
        "entities": {
            "Person": {
                "properties": {
                    "Followers": {
                        "type": "continuous",
                        "range": [
                            0,
                            100000
                        ]
                    },
                    "Interest": {
                        "type": "categorical",
                        "values": [
                            "Tech",
                            "Art",
                            "Music",
                            "Politics"
                        ]
                    }
                }
            },
            "Group": {
                "properties": {
                    "Members": {
                        "type": "continuous",
                        "range": [
                            0,
                            5000
                        ]
                    },
                    "Category": {
                        "type": "categorical",
                        "values": [
                            "Public",
                            "Private"
                        ]
                    }
                }
            }
        },
        "relationships": {
            "Follows": {
                "properties": {
                    "InteractionRate": {
                        "type": "continuous",
                        "range": [
                            0,
                            1
                        ]
                    }
                }
            },
            "MemberOf": {
                "properties": {}
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "Person": {
                "color": {
                    "source": "Interest",
                    "function": "categorical",
                    "palette": "schemeCategory10"
                },
                "size": {
                    "source": "Followers",
                    "function": "logarithmic",
                    "range": [
                        1,
                        5
                    ]
                },
                "glow": {
                    "source": "Followers",
                    "function": "linear",
                    "range": [
                        0,
                        0.5
                    ]
                }
            },
            "Group": {
                "geometry": {
                    "source": "constant",
                    "function": "constant",
                    "value": "dodecahedron"
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#FFD700"
                    }
                },
                "size": {
                    "source": "Members",
                    "function": "logarithmic",
                    "range": [
                        3,
                        8
                    ]
                }
            },
            "Follows": {
                "thickness": {
                    "source": "InteractionRate",
                    "function": "linear",
                    "range": [
                        0.05,
                        0.3
                    ]
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#88CCFF"
                    }
                },
                "opacity": {
                    "source": "InteractionRate",
                    "function": "linear",
                    "range": [
                        0.2,
                        0.8
                    ]
                }
            },
            "MemberOf": {
                "thickness": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.2,
                        0.2
                    ]
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#AAAAAA"
                    }
                }
            }
        }
    },
