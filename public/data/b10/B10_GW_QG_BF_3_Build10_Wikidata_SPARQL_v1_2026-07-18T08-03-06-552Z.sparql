SELECT ?entity ?entityLabel ?entityType ?validFrom ?validTo (GROUP_CONCAT(DISTINCT ?histEntry; separator=" | ") AS ?history) ?connectedEntity ?connectedEntityLabel ?relationshipType WHERE {
  {
    # KNOTEN: Historische Perioden und Institutionen
    VALUES ?entity { wd:Q17167 wd:Q2277 wd:Q130614 wd:Q10285 wd:Q1747689 }
    BIND("node" AS ?entityType)
    BIND("" AS ?relationshipType)
    
    OPTIONAL { ?entity wdt:P571 ?inception. }
    OPTIONAL { ?entity wdt:P580 ?startTime. }
    BIND(COALESCE(?inception, ?startTime) AS ?validFrom)
    
    OPTIONAL { ?entity wdt:P576 ?dissolved. }
    OPTIONAL { ?entity wdt:P582 ?endTime. }
    BIND(COALESCE(?dissolved, ?endTime) AS ?validTo)
    
    # History: Vorgänger/Nachfolger-Beziehungen für Epochen
    OPTIONAL { 
      ?entity wdt:P1365 ?replaces. 
      ?replaces rdfs:label ?replacesLabel. 
      FILTER(LANG(?replacesLabel) = "en")
      BIND(CONCAT("replaces:", STR(?replacesLabel)) AS ?histEntry)
    }
    OPTIONAL { 
      ?entity wdt:P1366 ?replacedBy. 
      ?replacedBy rdfs:label ?replacedByLabel. 
      FILTER(LANG(?replacedByLabel) = "en")
      BIND(CONCAT("replaced_by:", STR(?replacedByLabel)) AS ?histEntry)
    }
  }
  UNION
  {
    # KNOTEN: Römische Kaiser (Personen)
    ?entity wdt:P31 wd:Q5.
    ?entity wdt:P39 ?position.
    ?position wdt:P279* wd:Q842606.
    
    BIND("node" AS ?entityType)
    BIND("" AS ?relationshipType)
    
    OPTIONAL { ?entity wdt:P569 ?birth. }
    BIND(?birth AS ?validFrom)
    OPTIONAL { ?entity wdt:P570 ?death. }
    BIND(?death AS ?validTo)
    
    BIND(CONCAT("lifespan:", STR(YEAR(?birth)), "-", STR(YEAR(?death))) AS ?histEntry)
  }
  UNION
  {
    # KANTEN: Herrschaftsverhältnisse (Emperor -> Roman Empire)
    ?entity wdt:P31 wd:Q5.
    ?entity p:P39 ?statement.
    ?statement ps:P39 wd:Q842606.
    
    BIND("edge" AS ?entityType)
    BIND("ruled" AS ?relationshipType)
    BIND(wd:Q2277 AS ?connectedEntity)
    
    OPTIONAL { ?statement pq:P580 ?reignStart. }
    OPTIONAL { ?statement pq:P582 ?reignEnd. }
    BIND(?reignStart AS ?validFrom)
    BIND(?reignEnd AS ?validTo)
    
    BIND(CONCAT("reign_period:", STR(YEAR(?reignStart)), "-", STR(YEAR(?reignEnd))) AS ?histEntry)
  }
  
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en,de".
    ?entity rdfs:label ?entityLabel.
    ?connectedEntity rdfs:label ?connectedEntityLabel.
  }
}
GROUP BY ?entity ?entityLabel ?entityType ?validFrom ?validTo ?connectedEntity ?connectedEntityLabel ?relationshipType
LIMIT 100