                    "palette": "schemeCategory10"
                },
                "size": {
                    "source": "Population",
                    "function": "logarithmic",
                    "range": [
                        0.5,
                        3
                    ]
                },
                "label": {
                    "source": "Population",
                    "function": "constant",
                    "value": "visible"
                }
            },
            "Flight": {
                "thickness": {
                    "source": "FlightsPerDay",
                    "function": "linear",
                    "range": [
                        0.05,
                        0.4
                    ]
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#FFFFFF"
                    }
                },
                "opacity": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.1,
                        0.1
                    ]
                },
                "curvature": {
                    "source": "Distance_km",
                    "function": "linear",
                    "range": [
                        0.2,
                        2.0
                    ]
                }
            }
        }
    },
