    "dataModel": {
        "entities": {
            "City": {
                "properties": {
                    "Population": {
                        "type": "continuous",
                        "range": [
                            0,
                            40000000
                        ]
                    },
                    "Continent": {
                        "type": "categorical",
                        "values": [
                            "Europe",
                            "Asia",
                            "America",
                            "Africa",
                            "Australia"
                        ]
                    }
                }
            }
        },
        "relationships": {
            "Flight": {
                "properties": {
                    "Distance_km": {
                        "type": "continuous",
                        "range": [
                            0,
                            20000
                        ]
                    },
                    "FlightsPerDay": {
                        "type": "continuous",
                        "range": [
                            0,
                            100
                        ]
                    }
                }
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "City": {
                "color": {
                    "source": "Continent",
