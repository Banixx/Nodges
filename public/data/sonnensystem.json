{
    "system": "Sonnensystem Layout Demo",
    "metadata": {
        "created": "2026-01-12T22:55:00Z",
        "version": "1.0",
        "author": "Antigravity",
        "description": "Eine Visualisierung des Sonnensystems zur Demonstration der Layout-Funktionalität von Nodges. Zeigt die Sonne, alle Planeten und wichtige Monde mit ihren Beziehungen."
    },
    "dataModel": {
        "entities": {
            "stern": {
                "properties": {
                    "temperatur": {
                        "type": "continuous",
                        "range": [
                            0,
                            6000
                        ]
                    },
                    "masse": {
                        "type": "continuous"
                    }
                }
            },
            "planet": {
                "properties": {
                    "planetentyp": {
                        "type": "categorical",
                        "values": [
                            "gesteinsplanet",
                            "gasriese",
                            "eisriese"
                        ]
                    },
                    "hat_ringe": {
                        "type": "categorical",
                        "values": [
                            "ja",
                            "nein"
                        ]
                    },
                    "durchmesser_km": {
                        "type": "continuous"
                    }
                }
            },
            "mond": {
                "properties": {
                    "durchmesser_km": {
                        "type": "continuous"
                    }
                }
            },
            "zwergplanet": {
                "properties": {
                    "durchmesser_km": {
                        "type": "continuous"
                    }
                }
            }
        },
        "relationships": {
            "orbit": {
                "properties": {
                    "umlaufzeit_tage": {
                        "type": "continuous"
                    },
                    "entfernung_mio_km": {
                        "type": "continuous"
                    }
                }
            },
            "satellit": {
                "properties": {
                    "umlaufzeit_tage": {
                        "type": "continuous"
                    }
                }
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "stern": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": {
                        "color": "#ffcc00"
                    }
                },
