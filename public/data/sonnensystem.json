                    "source": "constant",
                    "function": "linear",
                    "params": {
                        "color": "#ffaa33"
                    }
                },
                "thickness": {
                    "source": "constant",
                    "function": "linear",
                    "range": [
                        0.12,
                        0.12
                    ]
                },
                "animation": {
                    "source": "constant",
                    "function": "pulse",
                    "params": {
                        "frequency": 1.5,
                        "speed": 0.8
                    }
                }
            },
            "satellit": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": {
                        "color": "#666666"
                    }
                },
                "thickness": {
                    "source": "constant",
                    "function": "linear",
                    "range": [
                        0.06,
                        0.06
                    ]
                },
                "opacity": {
                    "source": "constant",
                    "function": "linear",
                    "range": [
                        0.6,
                        0.6
                    ]
                }
            }
        }
    },
