{
  "system": "Nodges_Architecture",
  "metadata": {
    "schemaVersion": "4.0",
    "description": "Die Architektur von Nodges, abgebildet als interaktiver 3D-Graph in Nodges selbst.",
    "author": "Antigravity AI"
  },
  "dataModel": {
    "entities": {
      "module": {
        "properties": {
          "layer": {
            "type": "categorical",
            "values": ["Core", "Engine", "UI", "Data"]
          },
          "importance": {
            "type": "continuous",
            "range": [1, 10]
          }
        }
      },
      "component": {
        "properties": {
          "layer": {
            "type": "categorical",
            "values": ["Core", "Engine", "UI", "Data"]
          },
          "importance": {
            "type": "continuous",
            "range": [1, 10]
          }
        }
      }
    },
    "relationships": {
      "contains": { "properties": {} },
      "depends_on": { "properties": {} }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "module": {
        "color": { "source": "layer", "function": "categorical" },
        "size": { "source": "importance", "function": "linear", "range": [1.5, 3.0] }
      },
      "component": {
        "color": { "source": "layer", "function": "categorical" },
        "size": { "source": "importance", "function": "linear", "range": [0.8, 1.5] },
        "geometry": "box"
      },
      "contains": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#ffffff" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.1, 0.1] }
      },
      "depends_on": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#ffaa00" } },
        "thickness": { "source": "constant", "function": "constant", "range": [0.05, 0.05] }
      }
    }
  },
  "data": {
