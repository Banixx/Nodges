    "dataModel": {
        "entities": {
            "Element": {
                "properties": {
                    "Ordnungszahl": {
                        "type": "continuous",
                        "range": [
                            1,
                            118
                        ]
                    },
                    "Atommasse": {
                        "type": "continuous",
                        "range": [
                            1,
                            300
                        ],
                        "unit": "u"
                    },
                    "Gruppe": {
                        "type": "categorical",
                        "values": [
                            "Alkalimetalle",
                            "Erdalkalimetalle",
                            "Übergangsmetalle",
                            "Metalle",
                            "Halbmetalle",
                            "Nichtmetalle",
                            "Halogene",
                            "Edelgase",
                            "Lanthanoide",
                            "Actinoide"
                        ]
                    },
                    "Periode": {
                        "type": "continuous",
                        "range": [
                            1,
                            7
                        ]
                    },
                    "Aggregatzustand": {
                        "type": "categorical",
                        "values": [
                            "fest",
                            "flüssig",
                            "gasförmig"
                        ]
                    },
                    "Elektronegativität": {
                        "type": "continuous",
                        "range": [
                            0,
                            4
                        ]
                    }
                }
            }
        },
        "relationships": {
            "Benachbart": {
                "properties": {
                    "Richtung": {
                        "type": "categorical",
                        "values": [
                            "horizontal",
                            "vertikal"
                        ]
                    }
                }
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "Element": {
                "color": {
                    "source": "Gruppe",
                    "function": "categorical",
                    "palette": "schemeCategory10"
                },
                "size": {
                    "source": "Atommasse",
                    "function": "linear",
                    "range": [
                        1.5,
                        3.5
                    ]
                },
                "glow": {
                    "source": "Elektronegativität",
                    "function": "linear",
                    "range": [
                        0,
                        0.5
                    ]
                }
            },
            "Benachbart": {
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#333333"
                    }
                },
                "thickness": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.05,
                        0.05
                    ]
                },
                "opacity": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.2,
                        0.2
                    ]
                }
            }
        }
    },
