                            "NoSQL",
                            "Cache"
                        ]
                    }
                }
            },
            "Queue": {
                "properties": {
                    "Lag": {
                        "type": "continuous",
                        "range": [
                            0,
                            1000
                        ]
                    }
                }
            }
        },
        "relationships": {
            "Call": {
                "properties": {
                    "Latency_ms": {
