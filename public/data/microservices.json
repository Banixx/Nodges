                        "values": [
                            "Go",
                            "Node",
                            "Java",
                            "Python"
                        ]
                    }
                }
            },
            "Database": {
                "properties": {
                    "Size_GB": {
                        "type": "continuous",
                        "range": [
                            0,
                            1000
                        ]
                    },
