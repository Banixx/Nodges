{
  "system": "Proprietäre LLM Landschaft",
  "metadata": {
    "created": "2026-06-23T21:30:00Z",
    "version": "1.0",
    "author": "Antigravity",
    "description": "Visualisierung properietärer Large Language Models und ihrer Herausgeber"
  },
  "dataModel": {
    "entities": {
      "llm": {
        "properties": {
          "erscheinungsdatum": { "type": "categorical" },
          "parameter": { "type": "continuous", "range": [100, 2500] },
          "benchmark": { "type": "continuous", "range": [60, 100] },
          "preis_input": { "type": "continuous", "range": [0, 20] },
          "preis_output": { "type": "continuous", "range": [0, 80] },
          "token_sekunde": { "type": "continuous", "range": [10, 150] },
          "herausgeber": { "type": "categorical" },
          "beschreibung": { "type": "categorical" }
        }
      },
      "herausgeber": {
        "properties": {
          "typ": { "type": "categorical" }
        }
      }
    },
    "relationships": {
      "entwickelt_von": {
        "properties": {
          "art": { "type": "categorical" }
        }
      }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "llm": {
        "color": { "source": "herausgeber", "function": "categorical" },
        "size": { "source": "benchmark", "function": "linear", "range": [0.6, 1.5] }
      },
      "herausgeber": {
        "color": { "source": "typ", "function": "categorical" },
        "size": { "source": "constant", "function": "linear", "range": [1.5, 1.5] }
      },
      "entwickelt_von": {
        "color": { "source": "constant", "function": "constant", "params": { "color": "#aaaaaa" } },
        "thickness": { "source": "constant", "function": "linear", "range": [0.1, 0.1] }
      }
    }
  },
