{
    "system": "Nodges Layout Demo",
    "metadata": {
        "created": "2025-01-12",
        "version": "1.0",
        "author": "Nodges Assistant",
        "description": "A demo dataset representing a project management structure to test layout algorithms."
    },
    "dataModel": {
        "entities": {
            "person": {
                "properties": {
                    "role": {
                        "type": "categorical",
                        "values": [
                            "Manager",
                            "Lead",
                            "Developer",
                            "Designer"
                        ]
                    },
                    "experience": {
                        "type": "continuous",
                        "range": [
                            1,
                            20
                        ],
                        "unit": "years"
                    }
                }
            },
            "task": {
                "properties": {
                    "priority": {
                        "type": "categorical",
                        "values": [
                            "High",
                            "Medium",
                            "Low"
                        ]
                    },
                    "estimatedHours": {
                        "type": "continuous",
                        "range": [
                            1,
                            100
                        ],
                        "unit": "hours"
                    }
                }
            }
        },
        "relationships": {
            "reports_to": {
                "properties": {
                    "strength": {
                        "type": "continuous",
                        "range": [
                            0,
                            1
                        ]
                    }
                }
            },
            "assigned_to": {
                "properties": {
                    "allocation": {
                        "type": "continuous",
                        "range": [
                            0,
                            100
                        ],
                        "unit": "%"
                    }
                }
            },
            "depends_on": {
                "properties": {}
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "person": {
                "color": {
                    "source": "role",
                    "function": "categorical",
                    "palette": "schemeCategory10"
