                    "source": "priority",
                    "function": "categorical",
                    "palette": "schemeSet1"
                },
                "size": {
                    "source": "estimatedHours",
                    "function": "logarithmic",
                    "range": [
                        1,
                        3
                    ]
                },
                "geometry": {
                    "source": "fixed",
                    "function": "constant",
                    "value": "box"
                }
            }
        }
    },
