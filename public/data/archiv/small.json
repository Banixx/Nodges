{
  "system": "Simple Graph Example",
  "metadata": {
    "created": "2025-11-25T14:35:00Z",
    "version": "2.0",
    "author": "Nodges Team",
    "description": "Ein einfacher Graph mit 3 Knoten und mehreren Kanten, inklusive Mehrfach-Verbindungen"
  },
  "dataModel": {
    "entities": {
      "node": {
        "properties": {
          "position": {
            "type": "spatial",
            "coordinates": [
              "x",
              "y",
              "z"
            ]
          },
          "groesse": {
            "type": "continuous",
            "range": [
              10,
              100
            ]
          },
          "typ": {
            "type": "categorical",
            "values": [
              "A",
              "B",
              "C"
            ]
          }
        }
      }
    },
    "relationships": {
      "connection": {
        "properties": {
          "offset": {
            "type": "continuous",
            "range": [
              -10,
              10
            ],
            "unit": "units"
          },
          "staerke": {
            "type": "continuous",
            "range": [
              1,
              10
            ]
          }
        }
      }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "node": {
        "size": {
          "source": "groesse",
          "function": "linear",
          "domain": [
            10,
            100
          ],
          "range": [
            1.0,
            4.0
          ]
        },
        "color": {
          "source": "groesse",
          "function": "heatmap",
          "domain": [
            10,
            100
          ],
          "palette": "blue-red"
        }
      },
      "connection": {
        "thickness": {
          "source": "staerke",
          "function": "linear",
          "domain": [
            1,
            10
          ],
          "range": [
            0.1,
            0.6
          ]
        }
      }
    }
  },
  "data": {
    "entities": [
      {
        "id": "node1",
        "type": "node",
        "label": "node 1",
        "position": {
          "x": -3.5,
          "y": 1.2,
          "z": -2.8
        },
        "groesse": 20,
        "typ": "A"
      },
      {
        "id": "node2",
        "type": "node",
        "label": "node 2",
        "position": {
          "x": 2.8,
          "y": 0.5,
          "z": 3.2
        },
        "groesse": 80,
        "typ": "B"
      },
      {
        "id": "node3",
        "type": "node",
        "label": "node 3",
        "position": {
          "x": -3.2,
          "y": 2.8,
          "z": 4.7
        },
        "groesse": 50,
        "typ": "C"
      }
    ],
    "relationships": [
      {
        "id": "edge1",
        "type": "connection",
        "source": "node3",
        "target": "node2",
        "label": "edge 1",
        "offset": 3,
        "staerke": 2
      },
      {
        "id": "edge2",
        "type": "connection",
        "source": "node3",
        "target": "node2",
        "label": "edge 2",
        "offset": 1,
        "staerke": 8
      },
      {
        "id": "edge3",
        "type": "connection",
        "source": "node2",
        "target": "node3",
        "label": "edge 3",
        "offset": 0,
        "staerke": 5
      },
      {
        "id": "edge4",
        "type": "connection",
        "source": "node3",
        "target": "node2",
        "label": "edge 4",
        "offset": -4,
        "staerke": 10
      }
    ]
  }
}