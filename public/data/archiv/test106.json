{
  "system": "NaCl-Kristall in Lösung – Elektrostatik",
  "metadata": {
    "schemaVersion": "3.0",
    "description": "Simulation eines NaCl-Kristalls, der sich in Wasser auflöst. Natrium-Kationen (Na+) und Chlor-Anionen (Cl-) interagieren über Coulomb-Kräfte. Wassermoleküle (H2O) bilden Hydrathüllen. Die Datei demonstriert Anziehung (entgegengesetzte Ladungen), Abstoßung (gleiche Ladungen) und Trägheit (atomare Masse)."
  },
  "dataModel": {
    "entities": {
      "kation": {
        "description": "Positiv geladenes Ion (Na+)",
        "properties": {
          "ladung": { "type": "continuous", "unit": "e", "range": [0, 2] },
          "masse": { "type": "continuous", "unit": "u", "range": [1, 40] },
          "ionenradius": { "type": "continuous", "unit": "pm", "range": [50, 200] }
        }
      },
      "anion": {
        "description": "Negativ geladenes Ion (Cl-)",
        "properties": {
          "ladung": { "type": "continuous", "unit": "e", "range": [-2, 0] },
          "masse": { "type": "continuous", "unit": "u", "range": [1, 40] },
          "ionenradius": { "type": "continuous", "unit": "pm", "range": [50, 200] }
        }
      },
      "wasser": {
        "description": "Dipol-Molekuel (H2O)",
        "properties": {
          "ladung": { "type": "continuous", "unit": "e", "range": [-0.5, 0.5] },
          "masse": { "type": "continuous", "unit": "u", "range": [1, 20] },
          "dipolmoment": { "type": "continuous", "unit": "D", "range": [0, 2] }
        }
      }
    },
    "relationships": {
      "ionenbindung": { "description": "Elektrostatische Bindung zwischen Ionen" },
      "hydratation": { "description": "Hydrathülle – Wasser umgibt Ion" },
      "wasserstoffbruecke": { "description": "H-Brücke zwischen Wassermolekülen" }
    }
  },
