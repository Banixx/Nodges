{
    "system": "Schweizer Polit-System",
    "metadata": {
        "created": "2026-05-07T21:10:00Z",
        "version": "1.0",
        "author": "Antigravity",
        "description": "Visualisierung des Schweizer Regierungssystems, der Parteien und des Bundesrates."
    },
    "dataModel": {
        "entities": {
            "organ": {
                "properties": {
                    "ebene": {
                        "type": "categorical",
                        "values": ["Bund", "Kanton", "Gemeinde"]
                    },
                    "sitze": {
                        "type": "continuous"
                    }
                }
            },
            "partei": {
                "properties": {
                    "ausrichtung": {
                        "type": "categorical",
                        "values": ["Links", "Mitte-Links", "Mitte", "Mitte-Rechts", "Rechts"]
                    },
                    "waehleranteil": {
                        "type": "continuous",
                        "range": [0, 100],
                        "unit": "%"
                    }
                }
            },
            "person": {
                "properties": {
                    "geschlecht": {
                        "type": "categorical",
                        "values": ["m", "w", "d"]
                    },
                    "amtsantritt": {
                        "type": "temporal"
                    }
                }
            }
        },
        "relationships": {
            "waehlt": {
                "properties": {
                    "turnus": {
                        "type": "categorical",
                        "values": ["4 Jahre", "bei Vakanz"]
                    }
                }
            },
            "mitglied_von": {
                "properties": {
                    "funktion": {
                        "type": "categorical",
                        "values": ["Mitglied", "Präsident", "Vizepräsident"]
                    }
                }
            },
            "gehoert_zu": {
                "properties": {}
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "organ": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "color": "#FFD700" }
                },
                "size": {
                    "source": "constant",
                    "function": "linear",
                    "range": [8.0, 8.0]
                },
                "glow": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "intensity": 2.0, "color": "#FFD700" }
                }
            },
            "partei": {
                "size": {
                    "source": "waehleranteil",
                    "function": "linear",
                    "domain": [0, 30],
                    "range": [4.0, 10.0]
                },
                "color": {
                    "source": "label",
                    "function": "categorical",
                    "params": {
                        "SVP": "#008B45",
                        "SP": "#E3000F",
                        "FDP": "#005BAA",
                        "Die Mitte": "#FF8C00",
                        "Grüne": "#84B414"
                    }
                }
            },
            "person": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "color": "#00FFFF" }
                },
                "size": {
                    "source": "constant",
                    "function": "linear",
                    "range": [2.5, 2.5]
                },
                "glow": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "intensity": 0.5, "color": "#00FFFF" }
                }
            },
            "waehlt": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "color": "#FFFFFF" }
                },
                "thickness": {
                    "source": "constant",
                    "function": "linear",
                    "range": [0.2, 0.2]
                },
                "animation": {
                    "source": "constant",
                    "function": "pulse",
                    "params": { "frequency": 2.0, "speed": 2.0 }
                }
            },
            "mitglied_von": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "color": "#aaaaaa" }
                },
                "thickness": {
                    "source": "constant",
                    "function": "linear",
                    "range": [0.08, 0.08]
                },
                "opacity": {
                    "source": "constant",
                    "function": "linear",
                    "range": [0.6, 0.6]
                }
            },
            "gehoert_zu": {
                "color": {
                    "source": "constant",
                    "function": "linear",
                    "params": { "color": "#ffffff" }
                },
                "thickness": {
                    "source": "constant",
                    "function": "linear",
                    "range": [0.05, 0.05]
                },
                "curvature": {
                    "source": "constant",
                    "function": "linear",
                    "range": [0.5, 0.5]
                }
            }
        }
    },
