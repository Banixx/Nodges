{
  "system": "Sonnensystem",
  "metadata": {
    "schemaVersion": "5.0",
    "description": "Modell unseres Sonnensystems mit Sternen, Planeten, Zwergplaneten und Monden sowie ihren physikalischen und orbitalen Eigenschaften.",
    "author": "AI",
    "competencyQuestions": [
      "Welche Himmelkoerper umkreisen welche anderen und in welcher Distanz?",
      "Wie unterscheiden sich die Planeten in Masse, Groesse und Zusammensetzung?",
      "Welche Planeten haben die meisten Monde und wie verteilen sich diese?",
      "Wie hat sich das Sonnensystem zeitlich entwickelt (Entdeckungen, Statusaenderungen)?",
      "Welche Gruppierungen lassen sich erkennen (innere vs. aeussere Planeten, Gasriesen vs. Gesteinsplaneten)?"
    ],
    "map": { "image": "Map.jpg", "referenceWidth": 1000, "referenceHeight": 1000 }
  },
  "dataModel": {
