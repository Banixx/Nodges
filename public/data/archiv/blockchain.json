{
    "system": "Blockchain Transaction Viewer",
    "metadata": {
        "created": "2026-01-13T10:05:00Z",
        "description": "Visualisierung einer einfachen Blockchain mit Blocks und Wallets"
    },
    "dataModel": {
        "entities": {
            "Block": {
                "properties": {
                    "Height": {
                        "type": "continuous",
                        "range": [
                            0,
                            1000
                        ]
                    },
                    "Transactions": {
                        "type": "continuous",
                        "range": [
                            0,
                            5000
                        ]
                    },
                    "Miner": {
                        "type": "categorical",
                        "values": [
                            "Pool A",
                            "Pool B",
                            "SoloMiner",
                            "Unknown"
                        ]
                    }
                }
            },
            "Wallet": {
                "properties": {
                    "Balance": {
                        "type": "continuous",
                        "range": [
                            0,
                            1000
                        ]
                    },
                    "Type": {
                        "type": "categorical",
                        "values": [
                            "Exchange",
                            "User",
                            "Contract"
                        ]
                    }
                }
            }
        },
        "relationships": {
            "LinkedTo": {
                "properties": {}
            },
            "Transaction": {
                "properties": {
                    "Amount": {
                        "type": "continuous",
                        "range": [
                            0,
                            100
                        ]
                    }
                }
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "Block": {
                "geometry": {
                    "source": "constant",
                    "function": "constant",
                    "value": "box"
                },
                "color": {
                    "source": "Miner",
                    "function": "categorical",
                    "palette": "schemeSet2"
                },
                "size": {
                    "source": "Transactions",
                    "function": "linear",
                    "range": [
                        1,
                        3
                    ]
                },
                "position": {
                    "source": "Height",
                    "function": "linear",
                    "range": [
                        0,
                        100
                    ],
                    "params": {
                        "axis": "x",
                        "scale": 10
                    }
                }
            },
            "Wallet": {
                "geometry": {
                    "source": "constant",
                    "function": "constant",
                    "value": "sphere"
                },
                "color": {
                    "source": "Type",
                    "function": "categorical",
                    "palette": "schemeSet3"
                },
                "size": {
                    "source": "Balance",
                    "function": "logarithmic",
                    "range": [
                        0.5,
                        2
                    ]
                }
            },
            "LinkedTo": {
                "thickness": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.2,
                        0.2
                    ]
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#FFFFFF"
                    }
                }
            },
            "Transaction": {
                "thickness": {
                    "source": "Amount",
                    "function": "linear",
                    "range": [
                        0.05,
                        0.3
                    ]
                },
                "animation": {
                    "source": "constant",
                    "function": "pulse",
                    "params": {
                        "speed": 1
                    }
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#00FF00"
                    }
                }
            }
        }
    },
