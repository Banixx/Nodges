{
  "system": "Ergotherapie & Arbeitsagogik im Vergleich",
  "metadata": {
    "created": "2026-06-16T11:00:00Z",
    "version": "1.0",
    "author": "Antigravity",
    "description": "Systemische Gegenueberstellung, Gemeinsamkeiten, Schnittmengen und praxisspezifische Ausprägungen von Ergotherapie und Arbeitsagogik."
  },
  "dataModel": {
    "entities": {
      "Konzept": {
        "properties": {
          "disziplin_fokus": { "type": "continuous", "range": [-1.0, 1.0] },
          "typ": { "type": "categorical", "values": ["Profession", "System", "Medium", "Prinzip", "Ziel", "Grundlage"] },
          "ist_kern": { "type": "boolean" }
        }
      }
    },
    "relationships": {
      "Verbindung": {
        "properties": {
          "staerke": { "type": "continuous", "range": [0.1, 1.0] },
          "aktivitaet": { "type": "continuous", "range": [0.0, 1.0] }
        }
      }
    }
  },
  "visualMappings": {
    "defaultPresets": {
      "Konzept": {
        "size": { "source": "ist_kern", "function": "categorical", "params": { "mapping": { "true": 2.5, "false": 1.2 } } },
        "color": { "source": "disziplin_fokus", "function": "bipolar", "params": { "positive": "#e67e22", "negative": "#2980b9" } },
        "glow": { "source": "ist_kern", "function": "categorical", "params": { "mapping": { "true": 1.0, "false": 0.0 } } }
      },
      "Verbindung": {
        "color": { "source": "constant", "function": "linear", "params": { "color": "#7f8c8d" } },
        "thickness": { "source": "staerke", "function": "linear", "domain": [0.1, 1.0], "range": [0.03, 0.22] },
        "curvature": { "source": "constant", "function": "linear", "params": { "value": 0.15 } },
        "animation": { "source": "aktivitaet", "function": "pulse", "params": { "frequency": 2.0 } }
      }
    }
  },
