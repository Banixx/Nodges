    "dataModel": {
        "entities": {
            "Language": {
                "properties": {
                    "Year": {
                        "type": "continuous",
                        "range": [
                            1950,
                            2025
                        ]
                    },
                    "Paradigm": {
                        "type": "categorical",
                        "values": [
                            "Imperative",
                            "OO",
                            "Functional",
                            "Multi",
                            "Scripting"
                        ]
                    },
                    "Popularity": {
                        "type": "continuous",
                        "range": [
                            0,
                            100
                        ]
                    }
                }
            }
        },
        "relationships": {
            "Influenced": {
                "properties": {}
            }
        }
    },
    "visualMappings": {
        "defaultPresets": {
            "Language": {
                "color": {
                    "source": "Paradigm",
                    "function": "categorical",
                    "palette": "schemeTableau10"
                },
                "size": {
                    "source": "Popularity",
                    "function": "linear",
                    "range": [
                        1,
                        3
                    ]
                },
                "position": {
                    "source": "Year",
                    "function": "linear",
                    "range": [
                        1950,
                        2025
                    ],
                    "params": {
                        "axis": "y",
                        "scale": 10
                    }
                }
            },
            "Influenced": {
                "thickness": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.1,
                        0.1
                    ]
                },
                "color": {
                    "source": "constant",
                    "function": "constant",
                    "params": {
                        "color": "#DDDDDD"
                    }
                },
                "opacity": {
                    "source": "constant",
                    "function": "constant",
                    "range": [
                        0.3,
                        0.3
                    ]
                }
            }
        }
    },
