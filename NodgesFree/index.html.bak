<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NodgesFree - 3D System Explorer</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0a0a0f; color: #e0e0e0; overflow: hidden; height: 100vh; }
        #app { display: flex; flex-direction: column; height: 100vh; }
        #header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #2a2a4a; z-index: 100; }
        #header h1 { font-size: 1.4rem; font-weight: 600; background: linear-gradient(90deg, #00d4ff, #7b2cbf); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        #header-controls { display: flex; gap: 10px; align-items: center; }
        .btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; }
        .btn-secondary { background: #2a2a4a; color: #e0e0e0; }
        .btn-secondary:hover { background: #3a3a5a; }
        #main-container { display: flex; flex: 1; position: relative; }
        #canvas-container { flex: 1; position: relative; background: radial-gradient(ellipse at center, #1a1a2e 0%, #0a0a0f 100%); }
        #canvas { width: 100%; height: 100%; }
        #sidebar { width: 340px; background: #12121a; border-left: 1px solid #2a2a4a; display: flex; flex-direction: column; overflow: hidden; }
        .sidebar-section { padding: 15px; border-bottom: 1px solid #2a2a4a; }
        .sidebar-section h3 { font-size: 0.85rem; text-transform: uppercase; color: #888; margin-bottom: 10px; letter-spacing: 0.5px; }
        #system-info { background: #1a1a2e; border-radius: 8px; padding: 12px; }
        #system-info h2 { font-size: 1.1rem; margin-bottom: 8px; color: #00d4ff; }
        #system-info p { font-size: 0.85rem; color: #aaa; line-height: 1.5; }
        
        /* Info Panel */
        #info-panel { background: #1a1a2e; border-radius: 8px; padding: 12px; }
        #info-panel.empty { color: #666; font-style: italic; }
        #info-panel h4 { color: #00d4ff; margin-bottom: 8px; font-size: 1rem; border-bottom: 1px solid #2a2a4a; padding-bottom: 6px; }
        #info-panel .info-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.85rem; }
        #info-panel .info-label { color: #888; }
        #info-panel .info-value { color: #e0e0e0; text-align: right; }
        #info-panel .info-value.type-badge { padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
        #info-panel .info-section { margin-top: 10px; padding-top: 10px; border-top: 1px solid #2a2a4a; }
        #info-panel .info-section h5 { color: #7b2cbf; font-size: 0.8rem; margin-bottom: 6px; }
        
        /* Legende */
        #legend-panel { background: #1a1a2e; border-radius: 8px; padding: 12px; }
        .legend-section { margin-bottom: 12px; }
        .legend-section:last-child { margin-bottom: 0; }
        .legend-section h5 { font-size: 0.75rem; color: #888; margin-bottom: 6px; text-transform: uppercase; }
        .legend-item { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 0.8rem; }
        .legend-color { width: 16px; height: 16px; border-radius: 3px; flex-shrink: 0; }
        .legend-line { width: 24px; height: 3px; border-radius: 2px; flex-shrink: 0; }
        .legend-arrow { font-size: 0.7rem; color: #888; }
        
        /* Edge Direction Icons */
        .edge-legend { display: flex; align-items: center; gap: 4px; }
        .arrow-uni { color: #00d4ff; }
        .arrow-bi { color: #7b2cbf; }
        .arrow-feedback { color: #ff7675; }
        
        #entity-list { flex: 1; overflow-y: auto; padding: 10px; }
        .entity-item { background: #1a1a2e; border-radius: 6px; padding: 10px 12px; margin-bottom: 6px; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; }
        .entity-item:hover { background: #252540; border-color: #3a3a5a; }
        .entity-item.selected { border-color: #00d4ff; background: #1a2a3a; }
        .entity-item .label { font-weight: 500; margin-bottom: 4px; }
        .entity-item .type { font-size: 0.75rem; color: #888; }
        
        #controls-panel { padding: 15px; background: #0d0d15; }
        .control-group { margin-bottom: 15px; }
        .control-group label { display: block; font-size: 0.8rem; color: #888; margin-bottom: 6px; }
        .control-group input[type="checkbox"] { margin-right: 8px; }
        
        #hover-info { position: absolute; background: rgba(20, 20, 35, 0.95); border: 1px solid #00d4ff; border-radius: 8px; padding: 12px 16px; pointer-events: none; opacity: 0; transition: opacity 0.2s; z-index: 1000; max-width: 280px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); }
        #hover-info.visible { opacity: 1; }
        #hover-info h4 { color: #00d4ff; margin-bottom: 6px; }
        #hover-info .prop { font-size: 0.8rem; color: #aaa; margin: 3px 0; }
        #hover-info .prop span { color: #e0e0e0; }
        
        #process-panel { position: absolute; bottom: 20px; left: 20px; background: rgba(20, 20, 35, 0.95); border: 1px solid #7b2cbf; border-radius: 8px; padding: 15px; min-width: 250px; z-index: 100; }
        #process-panel h4 { color: #7b2cbf; margin-bottom: 10px; font-size: 0.9rem; }
        .process-item { display: flex; align-items: center; gap: 10px; padding: 8px; background: #1a1a2e; border-radius: 6px; margin-bottom: 6px; }
        .process-indicator { width: 10px; height: 10px; border-radius: 50%; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } }
        
        #stats-panel { position: absolute; top: 20px; right: 360px; background: rgba(20, 20, 35, 0.9); border: 1px solid #2a2a4a; border-radius: 8px; padding: 12px; font-size: 0.8rem; z-index: 100; }
        .stat { display: flex; justify-content: space-between; gap: 20px; margin: 4px 0; }
        .stat-label { color: #888; }
        .stat-value { color: #00d4ff; font-weight: 500; }
        
        #loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 200; }
        .spinner { width: 50px; height: 50px; border: 3px solid #2a2a4a; border-top-color: #00d4ff; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 15px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .hidden { display: none !important; }
        
        #camera-controls { position: absolute; bottom: 20px; right: 360px; display: flex; flex-direction: column; gap: 5px; z-index: 100; }
        #camera-controls .btn { padding: 10px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
        select { padding: 8px 16px; background: #2a2a4a; color: #e0e0e0; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
        
        /* Scrollbar styling */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1a1a2e; }
        ::-webkit-scrollbar-thumb { background: #3a3a5a; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4a4a6a; }
    </style>
</head>
<body>
    <div id="app">
        <div id="header">
            <h1>NodgesFree - 3D System Explorer</h1>
            <div id="header-controls">
                <button class="btn btn-secondary" id="btn-reset">Zuruecksetzen</button>
                <button class="btn btn-secondary" id="btn-animate">Animation</button>
                <select id="btn-load">
                    <option value="">Daten auswaehlen...</option>
                    <option value="sonnensystem">Sonnensystem</option>
                    <option value="nervous_system_autonomic">Nervensystem</option>
                    <option value="microservices">Microservices</option>
                    <option value="food_web">Nahrungsnetz</option>
                    <option value="demo">Demo-Netzwerk</option>
                </select>
            </div>
        </div>
        <div id="main-container">
            <div id="canvas-container">
                <canvas id="canvas"></canvas>
                <div id="hover-info"><h4 id="hover-title">-</h4><div id="hover-props"></div></div>
                <div id="stats-panel">
                    <div class="stat"><span class="stat-label">Knoten</span><span class="stat-value" id="stat-nodes">0</span></div>
                    <div class="stat"><span class="stat-label">Kanten</span><span class="stat-value" id="stat-edges">0</span></div>
                    <div class="stat"><span class="stat-label">FPS</span><span class="stat-value" id="stat-fps">0</span></div>
                </div>
                <div id="process-panel" class="hidden"><h4>Aktive Prozesse</h4><div id="process-list"></div></div>
                <div id="camera-controls">
                    <button class="btn btn-secondary" id="btn-zoom-in">+</button>
                    <button class="btn btn-secondary" id="btn-zoom-out">-</button>
                    <button class="btn btn-secondary" id="btn-reset-view">O</button>
                </div>
                <div id="loading"><div class="spinner"></div><p>Laden...</p></div>
            </div>
            <div id="sidebar">
                <div class="sidebar-section"><h3>System</h3><div id="system-info"><h2 id="system-name">-</h2><p id="system-desc">-</p></div></div>
                
                <!-- Info Panel - Zeigt Details des ausgewählten Objekts -->
                <div class="sidebar-section">
                    <h3>Ausgewaehlt</h3>
                    <div id="info-panel" class="empty">
                        Klicken Sie auf ein Objekt, um Details anzuzeigen.
                    </div>
                </div>
                
                <!-- Legende -->
                <div class="sidebar-section">
                    <h3>Legende</h3>
                    <div id="legend-panel">
                        <div class="legend-section">
                            <h5>Knotentypen</h5>
                            <div class="legend-item"><div class="legend-color" style="background:#74B9FF"></div><span>ZNS (Cranial/Sacral)</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#FF7675"></div><span>ZNS (Thorakal/Lumbal)</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#D63031"></div><span>Ganglion (Sympathikus)</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#55E6C1"></div><span>Organ</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#0984E3"></div><span>Nerv (Parasympathikus)</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#FF7675"></div><span>Nerv (Sympathikus)</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#ffcc00"></div><span>Stern</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#4a90d9"></div><span>Planet</span></div>
                            <div class="legend-item"><div class="legend-color" style="background:#888888"></div><span>Mond</span></div>
                        </div>
                        <div class="legend-section">
                            <h5>Kantenrichtungen</h5>
                            <div class="legend-item">
                                <div class="legend-line" style="background:#00d4ff"></div>
                                <span class="arrow-uni">--></span>
                                <span>Unidirektional</span>
                            </div>
                            <div class="legend-item">
                                <div class="legend-line" style="background:#7b2cbf"></div>
                                <span class="arrow-bi"><--></span>
                                <span>Bidirektional</span>
                            </div>
                            <div class="legend-item">
                                <div class="legend-line" style="background:#ff7675"></div>
                                <span class="arrow-feedback">==></span>
                                <span>Feedback (Rueckkanal)</span>
                            </div>
                        </div>
                        <div class="legend-section">
                            <h5>Kantenhäufigkeit</h5>
                            <div class="legend-item"><div class="legend-line" style="background:#00d4ff; height:3px; border-style:dashed;"></div><span>Einmalig</span></div>
                            <div class="legend-item"><div class="legend-line" style="background:#00d4ff"></div><span>Periodisch</span></div>
                            <div class="legend-item"><div class="legend-line" style="background:#00d4ff; box-shadow: 0 0 4px #00d4ff;"></div><span>Kontinuierlich</span></div>
                        </div>
                    </div>
                </div>
                
                <div class="sidebar-section">
                    <h3>Steuerung</h3>
                    <div id="controls-panel">
                        <div class="control-group"><label>Auto-Rotation</label><input type="checkbox" id="ctrl-auto-rotate" checked></div>
                        <div class="control-group"><label>Kanten anzeigen</label><input type="checkbox" id="ctrl-show-edges" checked></div>
                        <div class="control-group"><label>Labels anzeigen</label><input type="checkbox" id="ctrl-show-labels" checked></div>
                    </div>
                </div>
                <div class="sidebar-section" style="flex: 1; overflow: hidden; display: flex; flex-direction: column;"><h3>Knoten</h3><div id="entity-list"></div></div>
            </div>
        </div>
    </div>
    
    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
        }
    }
    </script>
    
    <script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

// Farben für verschiedene Typen
const TYPE_COLORS = {
    'stern': 0xffcc00,
    'planet': 0x4a90d9,
    'mond': 0x888888,
    'zwergplanet': 0xaa77cc,
    'organ': 0x55E6C1,
    'nerv': 0x0984E3,
    'ganglion': 0xD63031,
    'zns': 0x74B9FF,
    'default': 0x00d4ff
};

// Edge-Typ Farben
const EDGE_COLORS = {
    'Nerv (Parasympathikus)': 0x0984E3,
    'Nerv (Sympathikus)': 0xFF7675,
    'default': 0x00d4ff
};

// Edge-Richtungstypen
const EDGE_DIRECTION = {
    'uni': { symbol: '-->', color: '#00d4ff' },      // Unidirektional
    'bi': { symbol: '<-->', color: '#7b2cbf' },       // Bidirektional
    'feedback': { symbol: '==>', color: '#ff7675' }   // Feedback (Rückkanal)
};

// Kantenhäufigkeit
const EDGE_FREQUENCY = {
    'once': { label: 'Einmalig', style: 'dashed' },
    'periodic': { label: 'Periodisch', style: 'solid' },
    'continuous': { label: 'Kontinuierlich', style: 'glow' }
};

class NodgesFreeEngine {
    constructor() {
        this.scene = null;
        this.camera = null;
        this.renderer = null;
        this.controls = null;
        this.clock = new THREE.Clock();
        
        this.nodes = new Map();
        this.edges = [];
        this.labels = new Map();
        this.nodeGroup = null;
        this.edgeGroup = null;
        this.labelGroup = null;
        this.edgeLabelGroup = null; // Für Edge-Labels
        
        this.raycaster = new THREE.Raycaster();
        this.mouse = new THREE.Vector2();
        
        this.selectedNode = null;
        this.selectedEdge = null;
        this.hoveredNode = null;
        
        this.currentData = null;
        this.visualMappings = {};
        
        this.settings = {
            showEdges: true,
            showLabels: true,
            autoRotate: true,
            animationEnabled: true
        };
        
        this.processes = [];
        this.fps = 0;
        this.frameCount = 0;
        this.lastFpsUpdate = 0;
        
        this.init();
    }
    
    init() {
        this.setupScene();
        this.setupCamera();
        this.setupRenderer();
        this.setupLights();
        this.setupControls();
        this.setupGroups();
        this.setupEventListeners();
        this.animate();
    }
    
    setupScene() {
        this.scene = new THREE.Scene();
        this.scene.background = new THREE.Color(0x0a0a0f);
        this.scene.fog = new THREE.FogExp2(0x0a0a0f, 0.002);
        
        const gridHelper = new THREE.GridHelper(200, 50, 0x2a2a4a, 0x2a2a4a);
        gridHelper.position.y = -50;
        gridHelper.material.opacity = 0.3;
        gridHelper.material.transparent = true;
        this.scene.add(gridHelper);
        
        // Ambient particles
        const geo = new THREE.BufferGeometry();
        const pos = new Float32Array(3000);
        for (let i = 0; i < 3000; i += 3) {
            pos[i] = (Math.random() - 0.5) * 400;
            pos[i + 1] = (Math.random() - 0.5) * 400;
            pos[i + 2] = (Math.random() - 0.5) * 400;
        }
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        this.scene.add(new THREE.Points(geo, new THREE.PointsMaterial({ color: 0x444466, size: 0.5, transparent: true, opacity: 0.6 })));
    }
    
    setupCamera() {
        const c = document.getElementById('canvas-container');
        this.camera = new THREE.PerspectiveCamera(60, c.clientWidth / c.clientHeight, 0.1, 2000);
        this.camera.position.set(0, 50, 150);
    }
    
    setupRenderer() {
        const c = document.getElementById('canvas-container');
        this.renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('canvas'), antialias: true });
        this.renderer.setSize(c.clientWidth, c.clientHeight);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    }
    
    setupLights() {
        this.scene.add(new THREE.AmbientLight(0x404060, 0.5));
        const dir = new THREE.DirectionalLight(0xffffff, 1);
        dir.position.set(50, 100, 50);
        this.scene.add(dir);
        const pl1 = new THREE.PointLight(0x00d4ff, 0.5, 200);
        pl1.position.set(-50, 50, 50);
        this.scene.add(pl1);
        const pl2 = new THREE.PointLight(0x7b2cbf, 0.3, 200);
        pl2.position.set(50, -50, -50);
        this.scene.add(pl2);
    }
    
    setupControls() {
        this.controls = new OrbitControls(this.camera, this.renderer.domElement);
        this.controls.enableDamping = true;
        this.controls.dampingFactor = 0.05;
        this.controls.minDistance = 20;
        this.controls.maxDistance = 500;
        this.controls.autoRotate = true;
        this.controls.autoRotateSpeed = 0.5;
    }
    
    setupGroups() {
        this.nodeGroup = new THREE.Group();
        this.edgeGroup = new THREE.Group();
        this.edgeLabelGroup = new THREE.Group();
        this.labelGroup = new THREE.Group();
        
        this.scene.add(this.nodeGroup);
        this.scene.add(this.edgeGroup);
        this.scene.add(this.edgeLabelGroup);
        this.scene.add(this.labelGroup);
    }
    
    setupEventListeners() {
        window.addEventListener('resize', () => this.onResize());
        
        const canvas = document.getElementById('canvas');
        canvas.addEventListener('mousemove', (e) => this.onMouseMove(e));
        canvas.addEventListener('click', () => this.onClick());
        
        document.getElementById('btn-reset').addEventListener('click', () => this.resetView());
        document.getElementById('btn-animate').addEventListener('click', () => this.toggleAnimation());
        document.getElementById('btn-load').addEventListener('change', (e) => {
            const v = e.target.value;
            if (v === 'demo') this.generateDemoData();
            else if (v) this.loadDataFile(v);
        });
        document.getElementById('btn-zoom-in').addEventListener('click', () => this.camera.position.multiplyScalar(0.8));
        document.getElementById('btn-zoom-out').addEventListener('click', () => this.camera.position.multiplyScalar(1.2));
        document.getElementById('btn-reset-view').addEventListener('click', () => this.resetView());
        document.getElementById('ctrl-auto-rotate').addEventListener('change', (e) => this.controls.autoRotate = e.target.checked);
        document.getElementById('ctrl-show-edges').addEventListener('change', (e) => {
            this.settings.showEdges = e.target.checked;
            this.edgeGroup.visible = e.target.checked;
            this.edgeLabelGroup.visible = e.target.checked;
        });
        document.getElementById('ctrl-show-labels').addEventListener('change', (e) => {
            this.settings.showLabels = e.target.checked;
            this.labelGroup.visible = e.target.checked;
        });
    }
    
    onResize() {
        const c = document.getElementById('canvas-container');
        this.camera.aspect = c.clientWidth / c.clientHeight;
        this.camera.updateProjectionMatrix();
        this.renderer.setSize(c.clientWidth, c.clientHeight);
    }
    
    onMouseMove(e) {
        const r = e.target.getBoundingClientRect();
        this.mouse.x = ((e.clientX - r.left) / r.width) * 2 - 1;
        this.mouse.y = -((e.clientY - r.top) / r.height) * 2 + 1;
        this.checkIntersections();
        this.updateHoverInfo(e);
    }
    
    onClick() {
        if (this.hoveredNode) {
            this.selectNode(this.hoveredNode);
        } else {
            this.deselectAll();
        }
    }
    
    checkIntersections() {
        this.raycaster.setFromCamera(this.mouse, this.camera);
        
        // Erst Knoten prüfen
        const nodeHits = this.raycaster.intersectObjects(this.nodeGroup.children, true);
        if (nodeHits.length > 0 && nodeHits[0].object.userData.nodeData) {
            this.hoveredNode = nodeHits[0].object.userData.nodeData;
            document.body.style.cursor = 'pointer';
            return;
        }
        
        // Dann Kanten prüfen
        const edgeHits = this.raycaster.intersectObjects(this.edgeGroup.children, true);
        if (edgeHits.length > 0 && edgeHits[0].object.userData.relData) {
            this.hoveredNode = null;
            document.body.style.cursor = 'pointer';
            return;
        }
        
        this.hoveredNode = null;
        document.body.style.cursor = 'default';
    }
    
    updateHoverInfo(e) {
        const hi = document.getElementById('hover-info');
        if (this.hoveredNode) {
            const n = this.hoveredNode;
            document.getElementById('hover-title').textContent = n.label || n.id;
            const pd = document.getElementById('hover-props');
            pd.innerHTML = `<div class="prop">Typ: <span>${n.type}</span></div>`;
            if (n.position) pd.innerHTML += `<div class="prop">Position: <span>${n.position.x.toFixed(1)}, ${n.position.y.toFixed(1)}, ${n.position.z.toFixed(1)}</span></div>`;
            hi.style.left = (e.clientX + 15) + 'px';
            hi.style.top = (e.clientY + 15) + 'px';
            hi.classList.add('visible');
        } else {
            hi.classList.remove('visible');
        }
    }
    
    // ========================================================================
    // INFO PANEL
    // ========================================================================
    
    updateInfoPanel() {
        const panel = document.getElementById('info-panel');
        
        if (this.selectedNode) {
            const node = this.selectedNode;
            const connections = this.getNodeConnections(node.id);
            const connectedNodes = this.getConnectedNodes(node.id);
            
            let html = `<h4>${node.label || node.id}</h4>`;
            html += `<div class="info-row"><span class="info-label">ID</span><span class="info-value">${node.id}</span></div>`;
            html += `<div class="info-row"><span class="info-label">Typ</span><span class="info-value type-badge" style="background:${this.getTypeColor(node.type)}20; color:${this.getTypeColor(node.type)}">${node.type}</span></div>`;
            
            if (node.position) {
                html += `<div class="info-row"><span class="info-label">Position</span><span class="info-value">${node.position.x.toFixed(1)}, ${node.position.y.toFixed(1)}, ${node.position.z.toFixed(1)}</span></div>`;
            }
            
            // Verbindungen
            html += `<div class="info-section"><h5>Verbindungen (${connections.length})</h5>`;
            if (connections.length > 0) {
                connections.forEach(conn => {
                    const targetLabel = this.getNodeLabel(conn.target) || conn.target;
                    const directionSymbol = this.getDirectionSymbol(conn);
                    html += `<div class="info-row"><span class="info-label">${directionSymbol}</span><span class="info-value" style="font-size:0.75rem">${conn.label || conn.target}</span></div>`;
                });
            } else {
                html += `<div class="info-row"><span class="info-label" style="color:#666">Keine Verbindungen</span></div>`;
            }
            html += `</div>`;
            
            // Verbundene Knoten
            html += `<div class="info-section"><h5>Verbundene Knoten</h5>`;
            if (connectedNodes.length > 0) {
                html += connectedNodes.map(n => `<div class="info-row"><span class="info-label">-</span><span class="info-value" style="font-size:0.75rem">${n.label || n.id}</span></div>`).join('');
            } else {
                html += `<div class="info-row"><span class="info-label" style="color:#666">Keine</span></div>`;
            }
            html += `</div>`;
            
            // Custom Properties
            const customProps = this.getCustomProperties(node);
            if (customProps.length > 0) {
                html += `<div class="info-section"><h5>Eigenschaften</h5>`;
                customProps.forEach(prop => {
                    html += `<div class="info-row"><span class="info-label">${prop.key}</span><span class="info-value">${prop.value}</span></div>`;
                });
                html += `</div>`;
            }
            
            panel.innerHTML = html;
            panel.classList.remove('empty');
        } else if (this.selectedEdge) {
            const edge = this.selectedEdge;
            const sourceNode = this.nodes.get(edge.source)?.userData?.nodeData;
            const targetNode = this.nodes.get(edge.target)?.userData?.nodeData;
            
            let html = `<h4>${edge.label || edge.id}</h4>`;
            html += `<div class="info-row"><span class="info-label">ID</span><span class="info-value">${edge.id}</span></div>`;
            html += `<div class="info-row"><span class="info-label">Typ</span><span class="info-value type-badge" style="background:${this.getEdgeColor(edge)}20; color:${this.getEdgeColor(edge)}">${edge.type}</span></div>`;
            
            // Quelle und Ziel
            html += `<div class="info-section"><h5>Verbindung</h5>`;
            html += `<div class="info-row"><span class="info-label">Quelle</span><span class="info-value">${sourceNode?.label || edge.source}</span></div>`;
            html += `<div class="info-row"><span class="info-label">Ziel</span><span class="info-value">${targetNode?.label || edge.target}</span></div>`;
            html += `</div>`;
            
            // Richtung und Frequenz
            const direction = edge.direction || 'uni';
            const frequency = edge.frequency || 'periodic';
            const directionInfo = EDGE_DIRECTION[direction] || EDGE_DIRECTION['uni'];
            const frequencyInfo = EDGE_FREQUENCY[frequency] || EDGE_FREQUENCY['periodic'];
            
            html += `<div class="info-section"><h5>Kanten-Eigenschaften</h5>`;
            html += `<div class="info-row"><span class="info-label">Richtung</span><span class="info-value" style="color:${directionInfo.color}">${directionInfo.symbol} ${direction}</span></div>`;
            html += `<div class="info-row"><span class="info-label">Haeufigkeit</span><span class="info-value">${frequencyInfo.label}</span></div>`;
            if (edge.feedback) {
                html += `<div class="info-row"><span class="info-label">Feedback</span><span class="info-value">${edge.feedback}</span></div>`;
            }
            html += `</div>`;
            
            // Custom Properties
            const customProps = this.getCustomProperties(edge);
            if (customProps.length > 0) {
                html += `<div class="info-section"><h5>Eigenschaften</h5>`;
                customProps.forEach(prop => {
                    html += `<div class="info-row"><span class="info-label">${prop.key}</span><span class="info-value">${prop.value}</span></div>`;
                });
                html += `</div>`;
            }
            
            panel.innerHTML = html;
            panel.classList.remove('empty');
        } else {
            panel.innerHTML = 'Klicken Sie auf ein Objekt, um Details anzuzeigen.';
            panel.classList.add('empty');
        }
    }
    
    getNodeConnections(nodeId) {
        if (!this.currentData?.data?.relationships) return [];
        return this.currentData.data.relationships.filter(r => r.source === nodeId || r.target === nodeId);
    }
    
    getConnectedNodes(nodeId) {
        const connections = this.getNodeConnections(nodeId);
        const connectedIds = new Set();
        connections.forEach(c => {
            if (c.source === nodeId) connectedIds.add(c.target);
            else if (c.target === nodeId) connectedIds.add(c.source);
        });
        
        if (!this.currentData?.data?.entities) return [];
        return this.currentData.data.entities.filter(e => connectedIds.has(e.id));
    }
    
    getNodeLabel(nodeId) {
        const node = this.currentData?.data?.entities?.find(e => e.id === nodeId);
        return node?.label;
    }
    
    getDirectionSymbol(edge) {
        const direction = edge.direction || 'uni';
        const info = EDGE_DIRECTION[direction] || EDGE_DIRECTION['uni'];
        return info.symbol;
    }
    
    getTypeColor(type) {
        // Aus visualMappings holen falls vorhanden
        const mapping = this.visualMappings[type];
        if (mapping?.color?.params?.color) {
            return mapping.color.params.color;
        }
        
        // Fallback auf TYPE_COLORS
        for (const [key, color] of Object.entries(TYPE_COLORS)) {
            if (type?.toLowerCase().includes(key.toLowerCase())) {
                return '#' + color.toString(16).padStart(6, '0');
            }
        }
        return '#' + TYPE_COLORS['default'].toString(16).padStart(6, '0');
    }
    
    getEdgeColor(edge) {
        // Aus visualMappings holen falls vorhanden
        const mapping = this.visualMappings[edge.type];
        if (mapping?.color?.params?.color) {
            return mapping.color.params.color;
        }
        
        for (const [key, color] of Object.entries(EDGE_COLORS)) {
            if (edge.type?.includes(key)) {
                return '#' + color.toString(16).padStart(6, '0');
            }
        }
        return '#00d4ff';
    }
    
    getCustomProperties(obj) {
        const skip = ['id', 'type', 'label', 'position', 'source', 'target', 'direction', 'frequency', 'feedback'];
        const props = [];
        for (const [key, value] of Object.entries(obj)) {
            if (!skip.includes(key) && (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean')) {
                props.push({ key, value: String(value) });
            }
        }
        return props;
    }
    
    selectNode(nd) {
        this.deselectAll();
        this.selectedNode = nd;
        
        // UI aktualisieren
        document.querySelectorAll('.entity-item').forEach(i => i.classList.remove('selected'));
        const el = document.querySelector(`.entity-item[data-id="${nd.id}"]`);
        if (el) el.classList.add('selected');
        
        // Knoten highlighten
        const m = this.nodes.get(nd.id);
        if (m) {
            m.material.emissive = new THREE.Color(0xff6b6b);
            m.material.emissiveIntensity = 0.5;
        }
        
        // Verbundene Kanten highlighten
        this.highlightConnectedEdges(nd.id, true);
        
        // Info Panel aktualisieren
        this.updateInfoPanel();
    }
    
    selectEdge(edgeData) {
        this.deselectAll();
        this.selectedEdge = edgeData;
        
        // Kante highlighten
        const edge = this.edges.find(e => e.relData.id === edgeData.id);
        if (edge) {
            edge.material.emissive = new THREE.Color(0xff6b6b);
            edge.material.emissiveIntensity = 0.5;
        }
        
        // Info Panel aktualisieren
        this.updateInfoPanel();
    }
    
    highlightConnectedEdges(nodeId, highlight) {
        this.edges.forEach(edge => {
            if (edge.relData.source === nodeId || edge.relData.target === nodeId) {
                if (highlight) {
                    edge.material.emissive = new THREE.Color(0x7b2cbf);
                    edge.material.emissiveIntensity = 0.3;
                } else {
                    edge.material.emissive = new THREE.Color(0x000000);
                    edge.material.emissiveIntensity = 0;
                }
            }
        });
    }
    
    deselectAll() {
        // Knoten deselektieren
        if (this.selectedNode) {
            const m = this.nodes.get(this.selectedNode.id);
            if (m) {
                m.material.emissive = new THREE.Color(0);
                m.material.emissiveIntensity = 0;
            }
            this.highlightConnectedEdges(this.selectedNode.id, false);
        }
        this.selectedNode = null;
        
        // Kante deselektieren
        if (this.selectedEdge) {
            const edge = this.edges.find(e => e.relData.id === this.selectedEdge.id);
            if (edge) {
                edge.material.emissive = new THREE.Color(0);
                edge.material.emissiveIntensity = 0;
            }
        }
        this.selectedEdge = null;
        
        document.querySelectorAll('.entity-item').forEach(i => i.classList.remove('selected'));
        this.updateInfoPanel();
    }
    
    // ========================================================================
    // DATENLADEN
    // ========================================================================
    
    async loadDataFile(fn) {
        document.getElementById('loading').classList.remove('hidden');
        try {
            const r = await fetch(`./data/${fn}.json`);
            if (r.ok) {
                const d = await r.json();
                this.loadGraphData(d);
            } else {
                this.generateDemoData();
            }
        } catch {
            this.generateDemoData();
        }
        document.getElementById('loading').classList.add('hidden');
    }
    
    loadGraphData(d) {
        this.clearScene();
        this.currentData = d;
        
        document.getElementById('system-name').textContent = d.system || 'Unbekanntes System';
        document.getElementById('system-desc').textContent = d.metadata?.description || '';
        
        this.visualMappings = d.visualMappings?.defaultPresets || {};
        
        (d.data?.entities || []).forEach(e => this.createNode(e, this.visualMappings[e.type]));
        (d.data?.relationships || []).forEach(r => this.createEdge(r, this.visualMappings[r.type]));
        
        document.getElementById('stat-nodes').textContent = (d.data?.entities || []).length;
        document.getElementById('stat-edges').textContent = (d.data?.relationships || []).length;
        
        this.updateEntityList(d.data?.entities || []);
        this.createProcesses(d.data?.relationships || []);
        this.updateLegend();
        this.updateInfoPanel();
        
        this.centerCamera();
    }
    
    generateDemoData() {
        const dd = {
            system: 'Beispiel-Netzwerk',
            metadata: { description: 'Ein generiertes Demo-Netzwerk mit erweiterten Edge-Typen' },
            data: {
                entities: [
                    { id: 'hub1', type: 'default', label: 'Zentraler Knoten', position: { x: 0, y: 0, z: 0 } },
                    { id: 'node1', type: 'default', label: 'Knoten A', position: { x: 30, y: 20, z: 10 } },
                    { id: 'node2', type: 'default', label: 'Knoten B', position: { x: -30, y: 15, z: -15 } },
                    { id: 'node3', type: 'default', label: 'Knoten C', position: { x: 10, y: -25, z: 20 } },
                    { id: 'node4', type: 'default', label: 'Knoten D', position: { x: -15, y: -20, z: -25 } },
                    { id: 'node5', type: 'default', label: 'Knoten E', position: { x: 40, y: -10, z: -5 } }
                ],
                relationships: [
                    { id: 'e1', type: 'default', source: 'hub1', target: 'node1', label: 'Befehl', direction: 'uni', frequency: 'periodic' },
                    { id: 'e2', type: 'default', source: 'hub1', target: 'node2', label: 'Datenfluss', direction: 'bi', frequency: 'continuous' },
                    { id: 'e3', type: 'default', source: 'hub1', target: 'node3', label: 'Anfrage', direction: 'uni', frequency: 'periodic' },
                    { id: 'e4', type: 'default', source: 'node3', target: 'hub1', label: 'Feedback', direction: 'feedback', frequency: 'continuous', feedback: 'Status-Updates' },
                    { id: 'e5', type: 'default', source: 'node1', target: 'node5', label: 'Einmalige Aktion', direction: 'uni', frequency: 'once' },
                    { id: 'e6', type: 'default', source: 'hub1', target: 'node4', label: 'Bidirektional', direction: 'bi', frequency: 'periodic' }
                ]
            }
        };
        this.loadGraphData(dd);
    }
    
    createNode(ed, vp = {}) {
        const pos = ed.position || { x: 0, y: 0, z: 0 };
        
        let color = TYPE_COLORS['default'];
        if (vp?.color?.params?.color) {
            color = new THREE.Color(vp.color.params.color).getHex();
        } else {
            // Typ-basierte Farbe
            for (const [key, c] of Object.entries(TYPE_COLORS)) {
                if (ed.type?.toLowerCase().includes(key.toLowerCase())) {
                    color = c;
                    break;
                }
            }
        }
        
        let size = vp?.size?.range ? (vp.size.range[0] + vp.size.range[1]) / 2 : 3;
        
        const geo = ed.type?.includes('ganglion') || ed.type?.includes('zns')
            ? new THREE.OctahedronGeometry(1.2)
            : ed.type?.includes('nerv')
            ? new THREE.TorusGeometry(0.8, 0.3, 16, 32)
            : new THREE.SphereGeometry(1, 32, 32);
        
        const mat = new THREE.MeshStandardMaterial({
            color,
            metalness: 0.3,
            roughness: 0.4,
            emissive: 0,
            emissiveIntensity: 0
        });
        
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(pos.x, pos.y, pos.z);
        mesh.scale.setScalar(size);
        mesh.userData = { nodeData: ed };
        
        this.nodeGroup.add(mesh);
        this.nodes.set(ed.id, mesh);
        
        this.createLabel(ed.label || ed.id, pos);
    }
    
    createLabel(text, pos, color = '#ffffff') {
        const cv = document.createElement('canvas');
        cv.width = 512;
        cv.height = 128;
        const ctx = cv.getContext('2d');
        ctx.font = 'bold 32px Arial';
        ctx.fillStyle = color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 4;
        ctx.fillText(text, 256, 64);
        
        const sp = new THREE.Sprite(new THREE.SpriteMaterial({
            map: new THREE.CanvasTexture(cv),
            transparent: true,
            depthTest: false
        }));
        // Nahe am Knoten, direkt darüber
        sp.position.set(pos.x, pos.y + 4, pos.z);
        sp.scale.set(20, 6, 1);
        
        this.labelGroup.add(sp);
        this.labels.set(text, sp);
    }
    
    createEdge(rd, vp = {}) {
        const sn = this.nodes.get(rd.source);
        const tn = this.nodes.get(rd.target);
        if (!sn || !tn) return;
        
        // Farbe bestimmen
        let color = vp?.color?.params?.color ? new THREE.Color(vp.color.params.color).getHex() : 0x00d4ff;
        for (const [key, c] of Object.entries(EDGE_COLORS)) {
            if (rd.type?.includes(key)) {
                color = c;
                break;
            }
        }
        
        const thick = vp?.thickness?.range ? (vp.thickness.range[0] + vp.thickness.range[1]) / 2 : 0.15;
        
        // Richtung für visuelle Darstellung
        const direction = rd.direction || 'uni';
        const frequency = rd.frequency || 'periodic';
        
        // Kurve erstellen
        const start = sn.position.clone();
        const end = tn.position.clone();
        const mid = start.clone().add(end).multiplyScalar(0.5);
        
        // Bei bidirektional oder Feedback andere Kurve
        if (direction === 'bi') {
            mid.y += 8;
        } else if (direction === 'feedback') {
            mid.y -= 3;
        } else {
            mid.y += 5;
        }
        
        const curve = new THREE.QuadraticBezierCurve3(start, mid, end);
        
        // Geometrie erstellen
        const geo = new THREE.TubeGeometry(curve, 32, thick, 8, false);
        
        // Material mit Animation basierend auf Frequenz
        const mat = new THREE.MeshStandardMaterial({
            color,
            transparent: true,
            opacity: 0.8,
            emissive: color,
            emissiveIntensity: 0.2
        });
        
        const tube = new THREE.Mesh(geo, mat);
        tube.userData = { relData: rd };
        
        this.edgeGroup.add(tube);
        this.edges.push({ mesh: tube, material: mat, curve, relData: rd, direction, frequency });
        
        // Edge-Label erstellen
        this.createEdgeLabel(rd, mid, color, direction, frequency);
        
        // Pfeilspitzen hinzufuegen basierend auf Richtung
        this.createArrowheads(start, end, mid, color, direction);
    }
    
    createEdgeLabel(rd, position, color, direction, frequency) {
        // Nur Label erstellen wenn Text vorhanden
        const text = rd.label || '';
        if (!text) return;
        
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 64;
        const ctx = canvas.getContext('2d');
        
        // Richtung-Symbol hinzufuegen
        const dirSymbol = EDGE_DIRECTION[direction]?.symbol || '-->';
        
        // Frequenz-Indikator
        let freqIndicator = '';
        if (frequency === 'once') freqIndicator = ' [1x]';
        else if (frequency === 'continuous') freqIndicator = ' [~]';
        else if (frequency === 'periodic') freqIndicator = ' [T]';
        
        const fullText = `${dirSymbol} ${text}${freqIndicator}`;
        
        ctx.font = 'bold 20px Arial';
        ctx.fillStyle = color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 4;
        ctx.fillText(fullText, 256, 32);
        
        const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
            map: new THREE.CanvasTexture(canvas),
            transparent: true,
            depthTest: false
        }));
        
        // Nahe an der Kante, leicht versetzt nach oben
        sprite.position.copy(position);
        sprite.position.y += 3;
        sprite.scale.set(25, 4, 1);
        
        this.edgeLabelGroup.add(sprite);
    }
    
    createArrowheads(start, end, mid, color, direction) {
        // Einfache Pfeilmarkierungen am Start und Ende
        if (direction === 'bi') {
            // Zwei kleine Pfeilspitzen
            this.addArrowhead(start, mid, color, 0x7b2cbf);
            this.addArrowhead(end, mid, color, 0x7b2cbf);
        } else if (direction === 'uni') {
            // Nur eine am Ende
            this.addArrowhead(end, mid, color, 0x00d4ff);
        } else if (direction === 'feedback') {
            // Pfeil in Gegenrichtung
            this.addArrowhead(start, mid, color, 0xff7675);
        }
    }
    
    addArrowhead(position, target, color, emissiveColor) {
        const arrowGeo = new THREE.ConeGeometry(0.4, 1.2, 8);
        const arrowMat = new THREE.MeshStandardMaterial({
            color: emissiveColor,
            emissive: emissiveColor,
            emissiveIntensity: 0.3
        });
        
        const arrow = new THREE.Mesh(arrowGeo, arrowMat);
        
        // Richtung berechnen
        const dir = target.clone().sub(position).normalize();
        arrow.position.copy(position.clone().add(dir.multiplyScalar(2)));
        arrow.lookAt(target);
        arrow.rotateX(Math.PI / 2);
        
        this.edgeLabelGroup.add(arrow);
    }
    
    createProcesses(rels) {
        const pl = document.getElementById('process-list');
        pl.innerHTML = '';
        const pp = document.getElementById('process-panel');
        
        if (rels.length > 0) {
            pp.classList.remove('hidden');
            rels.slice(0, 5).forEach((r, i) => {
                const pi = document.createElement('div');
                pi.className = 'process-item';
                const ind = document.createElement('div');
                ind.className = 'process-indicator';
                
                // Farbe basierend auf Richtung
                const dir = r.direction || 'uni';
                const dirInfo = EDGE_DIRECTION[dir] || EDGE_DIRECTION['uni'];
                ind.style.backgroundColor = dirInfo.color;
                
                const lbl = document.createElement('span');
                lbl.textContent = r.label || `${r.source} -> ${r.target}`;
                
                pi.appendChild(ind);
                pi.appendChild(lbl);
                pl.appendChild(pi);
                
                this.processes.push({ rel: r, indicator: ind });
            });
        } else {
            pp.classList.add('hidden');
        }
    }
    
    updateEntityList(ents) {
        const list = document.getElementById('entity-list');
        list.innerHTML = '';
        
        ents.forEach(e => {
            const item = document.createElement('div');
            item.className = 'entity-item';
            item.dataset.id = e.id;
            
            const color = this.getTypeColor(e.type);
            
            item.innerHTML = `
                <div style="display:flex;align-items:center;gap:8px;">
                    <div style="width:12px;height:12px;border-radius:3px;background:${color};flex-shrink:0;"></div>
                    <div>
                        <div class="label">${e.label || e.id}</div>
                        <div class="type">${e.type}</div>
                    </div>
                </div>
            `;
            
            item.addEventListener('click', () => this.focusOnNode(e));
            list.appendChild(item);
        });
    }
    
    focusOnNode(ed) {
        const m = this.nodes.get(ed.id);
        if (!m) return;
        
        const target = m.position.clone();
        const start = this.camera.position.clone();
        const t = Date.now();
        
        const anim = () => {
            const p = Math.min((Date.now() - t) / 1000, 1);
            const e = 1 - Math.pow(1 - p, 3);
            this.camera.position.lerpVectors(start, target, e);
            this.camera.position.y += 20;
            this.camera.lookAt(target);
            if (p < 1) requestAnimationFrame(anim);
        };
        
        anim();
        this.selectNode(ed);
    }
    
    updateLegend() {
        const panel = document.getElementById('legend-panel');
        let html = '';
        
        // Knotentypen sammeln
        const nodeTypes = new Map();
        this.currentData?.data?.entities?.forEach(e => {
            const color = this.getTypeColor(e.type);
            nodeTypes.set(e.type, color);
        });
        
        if (nodeTypes.size > 0) {
            html += '<div class="legend-section"><h5>Knotentypen</h5>';
            nodeTypes.forEach((color, type) => {
                html += `<div class="legend-item"><div class="legend-color" style="background:${color}"></div><span>${type}</span></div>`;
            });
            html += '</div>';
        }
        
        // Edge-Richtungen
        html += `
            <div class="legend-section">
                <h5>Kantenrichtungen</h5>
                <div class="legend-item">
                    <div class="legend-line" style="background:${EDGE_DIRECTION.uni.color}"></div>
                    <span class="arrow-uni">${EDGE_DIRECTION.uni.symbol}</span>
                    <span>Unidirektional</span>
                </div>
                <div class="legend-item">
                    <div class="legend-line" style="background:${EDGE_DIRECTION.bi.color}"></div>
                    <span class="arrow-bi">${EDGE_DIRECTION.bi.symbol}</span>
                    <span>Bidirektional</span>
                </div>
                <div class="legend-item">
                    <div class="legend-line" style="background:${EDGE_DIRECTION.feedback.color}"></div>
                    <span class="arrow-feedback">${EDGE_DIRECTION.feedback.symbol}</span>
                    <span>Feedback (Rueckkanal)</span>
                </div>
            </div>
        `;
        
        // Kantenhäufigkeit
        html += `
            <div class="legend-section">
                <h5>Kantenhäufigkeit</h5>
                <div class="legend-item">
                    <div class="legend-line" style="background:#00d4ff; border-style:dashed; border-width:2px; border-color:#00d4ff; background:transparent;"></div>
                    <span>Einmalig</span>
                </div>
                <div class="legend-item">
                    <div class="legend-line" style="background:#00d4ff"></div>
                    <span>Periodisch</span>
                </div>
                <div class="legend-item">
                    <div class="legend-line" style="background:#00d4ff; box-shadow: 0 0 4px #00d4ff;"></div>
                    <span>Kontinuierlich</span>
                </div>
            </div>
        `;
        
        panel.innerHTML = html;
    }
    
    resetView() {
        this.camera.position.set(0, 50, 150);
        this.camera.lookAt(0, 0, 0);
        this.controls.reset();
    }
    
    centerCamera() {
        if (this.nodes.size === 0) return;
        const c = new THREE.Vector3();
        this.nodes.forEach(m => c.add(m.position));
        c.divideScalar(this.nodes.size);
        this.camera.position.copy(c).add(new THREE.Vector3(0, 50, 150));
        this.controls.target.copy(c);
    }
    
    toggleAnimation() {
        this.settings.animationEnabled = !this.settings.animationEnabled;
        document.getElementById('btn-animate').textContent = this.settings.animationEnabled ? 'Animation' : 'Stop';
        document.getElementById('btn-animate').style.background = this.settings.animationEnabled ? '' : '#ff6b6b';
    }
    
    clearScene() {
        while (this.nodeGroup.children.length > 0) {
            const c = this.nodeGroup.children[0];
            if (c.geometry) c.geometry.dispose();
            if (c.material) c.material.dispose();
            this.nodeGroup.remove(c);
        }
        this.nodes.clear();
        
        while (this.edgeGroup.children.length > 0) {
            const c = this.edgeGroup.children[0];
            if (c.geometry) c.geometry.dispose();
            if (c.material) c.material.dispose();
            this.edgeGroup.remove(c);
        }
        this.edges = [];
        
        while (this.edgeLabelGroup.children.length > 0) {
            const c = this.edgeLabelGroup.children[0];
            if (c.geometry) c.geometry.dispose();
            if (c.material) {
                if (c.material.map) c.material.map.dispose();
                c.material.dispose();
            }
            this.edgeLabelGroup.remove(c);
        }
        
        while (this.labelGroup.children.length > 0) {
            const c = this.labelGroup.children[0];
            if (c.material?.map) c.material.map.dispose();
            if (c.material) c.material.dispose();
            this.labelGroup.remove(c);
        }
        this.labels.clear();
        
        document.getElementById('entity-list').innerHTML = '';
        document.getElementById('process-panel').classList.add('hidden');
        this.processes = [];
        
        this.selectedNode = null;
        this.selectedEdge = null;
        this.currentData = null;
        this.visualMappings = {};
    }
    
    animate() {
        requestAnimationFrame(() => this.animate());
        
        const el = this.clock.getElapsedTime();
        this.controls.update();
        
        if (this.settings.animationEnabled) {
            this.edges.forEach((edge, i) => {
                const basePulse = 0.7 + Math.sin(el * 2 + i * 0.5) * 0.3;
                
                // Frequenz-basiert animieren
                if (edge.frequency === 'continuous') {
                    edge.material.opacity = 0.9;
                    edge.material.emissiveIntensity = basePulse * 0.5;
                } else if (edge.frequency === 'periodic') {
                    edge.material.opacity = basePulse;
                    edge.material.emissiveIntensity = basePulse * 0.3;
                } else {
                    // einmalig - kaum animieren
                    edge.material.opacity = 0.6;
                    edge.material.emissiveIntensity = 0.1;
                }
            });
            
            this.processes.forEach((pr, i) => {
                const speed = 1 + (i % 3) * 0.5;
                pr.indicator.style.opacity = 0.5 + Math.sin(el * speed) * 0.5;
            });
        }
        
        this.frameCount++;
        if (el - this.lastFpsUpdate >= 1) {
            this.fps = this.frameCount;
            this.frameCount = 0;
            this.lastFpsUpdate = el;
            document.getElementById('stat-fps').textContent = this.fps;
        }
        
        this.renderer.render(this.scene, this.camera);
    }
}

const engine = new NodgesFreeEngine();
setTimeout(() => engine.loadDataFile('nervous_system_autonomic'), 500);
console.log('NodgesFree Engine initialized (ES Modules)');
    </script>
</body>
</html>
